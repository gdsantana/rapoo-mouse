{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "w3c-web-hid"
    ],
    "paths": {
      "@/*": [
        "./apps/web/src/*"
      ]
    }
  },
  "include": [
    "apps",
    "packages",
    "tests"
  ]
}
